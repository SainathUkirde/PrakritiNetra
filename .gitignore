# ── Large binary datasets (GRIB2 / NetCDF) ────────────────────────────────────
# datasets/ and outputs/ are committed so Streamlit Cloud can use real data.
# Only cfgrib auto-generated index files are excluded (regenerated on first read).
*.idx

# ── Pipeline runtime outputs (generated by: python run_pipeline.py) ───────────
# outputs/ is committed — CSVs and pkl are needed by the dashboard on cloud.

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Development / audit scripts (any file starting with _) ───────────────────
_*.py
_*.txt

# ── OS / editor artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Streamlit local secrets ────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Node / frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env.local
